@model CuentaCreacionViewModel
@{
	ViewData["Title"] = "Crear Cuenta";
}

<h1>Crear Cuenta</h1>
<h5>
	Las cuentas son los lugares donde guardas tu dinero.<br />
	Ejemplos: Efectivo, cuenta bancaria, tarjeta de crédito, etc.
</h5>

<form asp-action="Crear">
	<div asp-validation-summary="ModelOnly" class="text-danger">
	</div>
	<div class="mb-3">
		<label asp-for="Nombre" class="form-label"></label>
		<input asp-for="Nombre" class="form-control" />
		<span asp-validation-for="Nombre" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="TipoCuentaId" class="form-label"></label>
		<select asp-for="TipoCuentaId" class="form-select" asp-items="Model.TiposCuentas">
			<option value="">-- Seleccione un tipo de cuenta --</option>
		</select>
		<span asp-validation-for="TipoCuentaId" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Balance" class="form-label"></label>
		<input asp-for="Balance" class="form-control" />
		<span asp-validation-for="Balance" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="descripcion" class="form-label"></label>
		<textarea asp-for="descripcion" class="form-control"></textarea>
		<span asp-validation-for="descripcion" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary">Crear</button>
	<a asp-action="Index" class="btn btn-secondary">Cancelar</a>
	</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}