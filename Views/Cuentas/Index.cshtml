@model IEnumerable<IndiceCuentasViewModel>

	@{
	ViewData["Title"] = "Cuentas";

	string FormatearBalance(decimal balance)
	{
		return Math.Abs(balance).ToString("N");
	}

	string ObtenerClaseBalanace(decimal balance)
	{
		return balance >= 0 ? "activo" : "pasivo";
	}
}

<h1>Cuentas</h1>
<a asp-action="Crear" class="btn btn-primary mb-3">Crear Nueva</a>

<div class="contenedor-totales mb-3 ">
	<div>
		<div>
			<strong>Activos:</strong>
		</div>
		<div class="activo">
		   @FormatearBalance(@Model.Where(X => X.BalanceTotal > 0).Sum(x => x.BalanceTotal))
		</div>
	</div>
	<div>
		<div >
			<strong>Pasivos:</strong>
		</div>
		<div class="pasivo">
			@FormatearBalance(@Model.Where(X => X.BalanceTotal < 0).Sum(x => x.BalanceTotal))
		</div>
	</div>
	<div>
		<div>
			<strong>Total:</strong>
		</div>
		<div>
			@FormatearBalance(@Model.Sum(x => x.BalanceTotal))
		</div>
</div>
</div>


<div class="accordion acordeon-cuentas" id="accordionCuentas">
	@foreach (var cuenta in Model)
	{
		var id = cuenta.tipoCuenta.Replace(" ", "");
		var dataBsTarget = "#" + id;
		var claseTipoCenta = ObtenerClaseBalanace(cuenta.BalanceTotal);

		<div class="accordion-item">
			<h2 class="accordion-header" id="cabecera-@id">
				<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="@dataBsTarget" aria-expanded="true" aria-controls="@id">
					<span class="me-3 d-flex justify-content-between w-100">
						<strong>@cuenta.tipoCuenta</strong>
						<span class="@claseTipoCenta">@FormatearBalance(cuenta.BalanceTotal)</span>
					</span>
				</button>
			</h2>

			<div id="@id" class="accordion-collapse collapse show" data-bs-parent="#accordionCuentas">
				<div class="accordion-body p-0">
					<ul class="list-group list-group-flush">
						@foreach (var cuentaHija in cuenta.Cuentas)
						{
							var claseCuentaHija = ObtenerClaseBalanace(cuentaHija.Balance);
							<li class="list-group-item d-flex justify-content-between align-items-center">
								<span class="d-flex align-items-center gap-2">
									<strong>
										<a asp-action="Detalle" asp-route-id="@cuentaHija.Id" class="text-decoration-none">
											@cuentaHija.Nombre
										</a>
									</strong>
									<a asp-action="Editar" asp-route-id="@cuentaHija.Id" class="btn btn-sm btn-primary" title="Editar">
										<i class="bi bi-pencil-fill"></i>
									</a>
									<a asp-action="Borrar" asp-route-id="@cuentaHija.Id" class="btn btn-sm btn-danger" title="Borrar">
										<i class="bi bi-trash-fill"></i>
									</a>
								</span>
								<span class="@claseCuentaHija">@FormatearBalance(cuentaHija.Balance)</span>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>
	}
</div>

@section Styles {
	<style>
		/* ✅ Fix: permitir clics dentro del contenido del acordeón */
		.accordion-button {
			z-index: 1;
		}

		.accordion-collapse {
			position: relative;
			z-index: 2;
		}

		/* Opcional: mejora visual */
		.acordeon-cuentas .list-group-item {
			border: none;
			border-bottom: 1px solid #dee2e6;
		}

		.acordeon-cuentas a {
			color: #0d6efd;
		}

		.acordeon-cuentas a:hover {
			text-decoration: underline;
		}
	</style>
}
