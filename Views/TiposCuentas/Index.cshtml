@model IEnumerable<TipoCuenta>

@{
    ViewData["Title"] = "Tipos de Cuentas";
}

<h1>Tipos de Cuentas</h1>
<h5>
    El tipo de cuentas se refiere a cómo podemos agrupar las cuentas.<br />
    Ejemplos: Préstamos, tarjetas, etc.
</h5>

<a asp-action="Crear" class="btn btn-primary mb-3">Crear Tipo de Cuenta</a>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody id="Reorden">
        @foreach (var tipoCuenta in Model)
        {
            <tr>
                <td>@tipoCuenta.Nombre</td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                        <input type="hidden" value="@tipoCuenta.id" class="ids" />
                        <a asp-action="Editar" asp-route-id="@tipoCuenta.id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Borrar" asp-route-id="@tipoCuenta.id" class="btn btn-danger btn-sm">Borrar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script>
        const urlReordenar = '@Url.Action("Ordenar")';
        
        $(function(){
			$("#Reorden").sortable({
                stop: async function(e, ui){
                    await actualizarOrdenes();
                    }
            });
                async function actualizarOrdenes(){
                    const ids = obtenerElementos();
                    await EnviarIdsBackend(ids);
                }

				function obtenerElementos(){
                    const ids = $(".ids").map(function(){
                          return $(this).val();
					}).get();
                    console.log(ids)
					return ids;
                }

                async function EnviarIdsBackend(ids){
					var data = JSON.stringify(ids);
                    await fetch(urlReordenar, {
                        method: 'POST',
                        body: data,
                        headers: {
                            'Content-Type': 'application/json'
                        }
					});
                
				}
        })
    </script>
   
}


