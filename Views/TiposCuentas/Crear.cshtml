@model TipoCuenta

@{
	ViewData["Title"] = "Crear Tipo de Cuenta";
}

<h1>Crear Tipo Cuenta</h1>
<h5>El tipo cuenta se refiere a como podemos agrupar nuestras cuentas.
	Por ejemplo: Efectivo, Tarjetas, Cuentas Bancarias, etc.
</h5>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-controller="TiposCuentas" asp-action="Crear">
	<div class="mb-3">
		<label asp-for="Nombre" class="form-label"></label>
		<input type="text" id="Nombre" name="Nombre" class="form-control" asp-for="Nombre" />	
		<span asp-validation-for="Nombre" class="text-danger"></span>
	</div>
	
	<button type="submit" class="btn btn-primary">Enviar</button>
	<a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

		@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}