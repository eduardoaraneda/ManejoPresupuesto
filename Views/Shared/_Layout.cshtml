<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ManejoPresupuesto</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        body {
            background-color: #f5f6fa;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-container {
            display: flex;
            flex: 1;
        }

        /* ==== SIDEBAR CLARO ==== */
        .sidebar {
            width: 250px;
            background: #eef1f5; /* Color claro */
            color: #333;
            flex-shrink: 0;
            transition: width 0.3s ease;
            border-right: 1px solid #d6d9dd;
            padding-top: 15px;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar .sidebar-header {
                font-size: 1.3rem;
                font-weight: bold;
                padding: 15px 20px;
                color: #333;
            }

            .sidebar .nav-link {
                color: #4b5563; /* Gris medio */
                padding: 12px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 4px 10px;
                border-radius: 8px;
                transition: background .25s, color .25s;
                font-weight: 500;
            }

                .sidebar .nav-link i {
                    font-size: 1.2rem;
                    color: #374151;
                }

                .sidebar .nav-link:hover {
                    background: #dce3eb; /* Hover */
                    color: #1f2937;
                }

                .sidebar .nav-link.active {
                    background: #cbdaf5; /* Azul suave */
                    color: #1f2937 !important;
                    font-weight: 600;
                }

            .sidebar.collapsed span {
                display: none;
            }

        /* Contenido principal */
        .content {
            flex-grow: 1;
            padding: 2rem;
            margin-left: 0;
        }

        footer {
            background-color: #212529;
            color: #adb5bd;
            text-align: center;
            padding: 1rem;
        }

            footer a {
                color: #ffc107;
                text-decoration: none;
            }

                footer a:hover {
                    color: #fff;
                }
    </style>
</head>

<body>
    <!-- NAVBAR SUPERIOR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <button class="btn btn-outline-light me-2" id="btnToggleSidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="navbar-brand fw-bold" asp-controller="Transacciones" asp-action="Index">
                <i class="bi bi-wallet2 me-2"></i> ManejoPresupuesto
            </a>
        </div>
    </nav>

    <div class="main-container">
        <!-- SIDEBAR IZQUIERDA -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <span>Menú</span>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="Transacciones" asp-action="Index">
                    <i class="bi bi-house-door"></i> <span>Transacciones</span>
                </a>

                <a class="nav-link" asp-controller="TiposCuentas" asp-action="Index">
                    <i class="bi bi-list-ul"></i> <span>Tipos de Cuentas</span>
                </a>

                <a class="nav-link" asp-controller="Cuentas" asp-action="Index">
                    <i class="bi bi-bank"></i> <span>Cuentas</span>
                </a>

                <a class="nav-link" asp-controller="Categorias" asp-action="Index">
                    <i class="bi bi-tags"></i> <span>Categorías</span>
                </a>

                <partial name="LinksLogin" />
            </nav>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <main role="main" class="content">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <p class="mb-0">
                &copy; 2025 ManejoPresupuesto —
                <a asp-controller="Home" asp-action="Privacy">Política de Privacidad</a>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

    <script>
        // Toggle del menú lateral
        document.getElementById("btnToggleSidebar").addEventListener("click", function () {
            document.getElementById("sidebar").classList.toggle("collapsed");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
