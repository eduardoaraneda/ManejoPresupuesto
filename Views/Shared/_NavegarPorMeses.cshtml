@model DateTime

@{
    // Detecta nombre de la acción actual (Index, Semanal, Mensual, etc.)
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

<div class="d-flex align-items-center justify-content-center mb-4">

    <a asp-action="@accionActual"
       asp-route-mes="@ViewBag.mesAnterior"
       asp-route-año="@ViewBag.anoAnterior"
       class="btn btn-outline-secondary me-3">
        <i class="bi bi-chevron-left"></i>
    </a>

    <h4 class="mb-0 text-capitalize">
        @Model.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
    </h4>

    <a asp-action="@accionActual"
       asp-route-mes="@ViewBag.mesSiguiente"
       asp-route-año="@ViewBag.anoSiguiente"
       class="btn btn-outline-secondary ms-3">
        <i class="bi bi-chevron-right"></i>
    </a>
</div>
