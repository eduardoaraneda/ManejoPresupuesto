@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager

<ul class="navbar-nav">
	@if(SignInManager.IsSignedIn(User))
	{
		<li class="nav-item">
			<span class="nav-link-danger text-dark">Hola, @User.Identity.Name</span>
		</li>
		<li>
			<form asp-controller="Usuarios" asp-action="Logout" method="post" class="form-inline">
				<button type="submit" class="btn btn-link nav-link text-dark">Cerrar sesión</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Registro">Registro</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Login">Iniciar sesión</a>
		</li>
	}
)
</ul>
