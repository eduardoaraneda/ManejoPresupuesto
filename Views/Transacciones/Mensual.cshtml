@model ReporteMensualViewModel

@{
	ViewData["Title"] = "Reporte Mensual";

	int anoAnterior = Model.ano - 1;
	int anoSiguiente = Model.ano + 1;
	var resumenMontos = new ResumenMontosViewModel
	{
		Gastos = Model.Egresos,
		Ingresos = Model.Ingresos,
		Total = Model.Total
	};
}

<partial name="Submenu" Model="SubMenuTransacciones.Mensual" />

<h4>Mostrando Transacciones de 
	<a asp-route-ano="@anoAnterior" class="btn btn-secondary">
		<i class="bi-chevron-left"></i>
	</a>@Model.ano
	<a asp-route-ano="@anoSiguiente" class="btn btn-secondary">
		<i class="bi-chevron-right"></i>
	</a>

</h4>

<partial name="_ResumenMontos" Model="@resumenMontos" />

<table class="table" style="font-size:20px">
	<thead>
		<tr>
			<th>Mes</th>
			<th style="text-align:right">Ingresos</th>
			<th style="text-align:right">Gastos</th>
		</tr>
	</thead>
	<tbody>
				@foreach (var transaccionesPorMes in Model.TransaccionePorMes)
		{
			<tr>
				<td>
					<a style="text-decoration:none" asp-action="Index"
					   asp-route-ano="@Model.ano"
					   asp-route-mes="@transaccionesPorMes.Mes">
						@transaccionesPorMes.Mes
					</a>
				</td>
				<td class="activo" style="text-align:right">
					@transaccionesPorMes.Ingresos
				</td>
				<td class="pasivo" style="text-align:right">
					@transaccionesPorMes.Egresos
				</td>
			</tr>
		}
	</tbody>
	
</table>